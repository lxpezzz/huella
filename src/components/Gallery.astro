---
import { Image } from "astro:assets";
import site from "../data/site.json";
---

<section id="trabajos" class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="gallery__header reveal">
      <p class="text-label gallery__eyebrow">Galería</p>
      <h2 id="gallery-title" class="text-display gallery__title">
        Algunos de nuestros peludos
      </h2>
    </div>

    <ul class="gallery__row" role="list">
      {
        site.images.gallery.map((src, index) => (
          <li class="gallery__item">
            <figure class="gallery__figure reveal-scale">
              <Image
                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${src.startsWith('/') ? src : `/${src}`}`}
                alt={`Trabajo de peluquería canina número ${index + 1}`}
                class="img-cover gallery__image"
                width={360}
                height={360}
                widths={[180, 360]}
                sizes="(max-width: 768px) 150px, 176px"
                decoding="async"
                loading="lazy"
              />
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--space-xl);
  }

  .gallery__header {
    margin-bottom: var(--space-md);
    display: grid;
    gap: var(--space-xs);
  }

  .gallery__eyebrow {
    color: var(--green);
  }

  .gallery__title {
    font-size: var(--text-xl);
    max-width: 18ch;
  }

  .gallery__row {
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-sm);
    -webkit-overflow-scrolling: touch;
  }

  .gallery__row::-webkit-scrollbar {
    height: 4px;
  }

  .gallery__row::-webkit-scrollbar-track {
    background-color: var(--border);
  }

  .gallery__row::-webkit-scrollbar-thumb {
    background-color: var(--green);
  }

  .gallery__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .gallery__figure {
    position: relative;
    width: clamp(8.5rem, 28vw, 11rem);
    height: clamp(8.5rem, 28vw, 11rem);
    margin: 0;
    overflow: hidden;
    background-color: var(--bg-warm);
    border-radius: var(--radius-sm);
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery__figure:hover .gallery__image {
    transform: scale(1.06);
  }

  @media (min-width: 768px) {
    .gallery__figure {
      width: 11rem;
      height: 11rem;
    }
  }
</style>
