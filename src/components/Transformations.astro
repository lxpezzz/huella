---
import { Image } from "astro:assets";
import site from "../data/site.json";
---

<section
  class="section section-warm transformations"
  aria-labelledby="transformations-title"
>
  <div class="container">
    <div class="transformations__header reveal">
      <p class="text-label transformations__eyebrow">Antes / después</p>
      <h2
        id="transformations-title"
        class="text-display transformations__title"
      >
        Un poquito de magia
      </h2>
    </div>

    <ul class="transformations__list" role="list">
      {
        site.images.beforeAfter.map((pair, index) => (
          <li class="transformations__case reveal">
            <article class="transformations__card">
              <div class="transformations__images">
                <figure class="transformations__figure transformations__figure--before">
                  <Image
                    src={`${import.meta.env.BASE_URL}${pair.before}`}
                    alt={`Antes de la sesión de peluquería ${index + 1}`}
                    class="img-cover transformations__image"
                    width={800}
                    height={800}
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 45vw, 22vw"
                    decoding="async"
                  />
                  <figcaption class="transformations__label">Antes</figcaption>
                </figure>
                <figure class="transformations__figure transformations__figure--after">
                  <Image
                    src={`${import.meta.env.BASE_URL}${pair.after}`}
                    alt={`Después de la sesión de peluquería ${index + 1}`}
                    class="img-cover transformations__image"
                    width={800}
                    height={800}
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 45vw, 22vw"
                    decoding="async"
                  />
                  <figcaption class="transformations__label transformations__label--after">
                    Después
                  </figcaption>
                </figure>
              </div>
              <h3 class="transformations__name">
                Caso {String(index + 1).padStart(2, "0")}
              </h3>
              <p class="transformations__desc">
                {index === 0
                  ? "Baño, deslanado y corte a mano para recuperar el volumen natural del pelaje."
                  : "Hidratación, corte de uñas y ajuste de cara y patitas con mucha paciencia."}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .transformations__header {
    margin-bottom: var(--space-xl);
    display: grid;
    gap: var(--space-xs);
  }

  .transformations__eyebrow {
    color: var(--caramel);
  }

  .transformations__title {
    font-size: var(--text-xl);
    max-width: 20ch;
  }

  .transformations__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .transformations__card {
    display: grid;
    gap: var(--space-md);
    border-radius: 2%;
  }

  .transformations__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background-color: #efece4;
  }

  .transformations__figure {
    position: relative;
    margin: 0;
    background-color: var(--bg);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 2%;
  }

  .transformations__image {
    transition: transform var(--transition-slow);
    border-radius: 2%;
  }

  .transformations__figure:hover .transformations__image {
    transform: scale(1.04);
  }

  .transformations__label {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--surface);
    color: var(--text);
    font-size: 10px;|
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .transformations__label--after {
    background-color: var(--green);
    color: var(--surface);
  }

  .transformations__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
||
    .transformations__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2xl);
    }|
  }
</style>
