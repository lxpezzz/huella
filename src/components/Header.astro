---
import site from "../data/site.json";

const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Trabajos", href: "#trabajos" },
  { label: "Opiniones", href: "#opiniones" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="header">
  <div class="container header__inner">
    <a
      href={import.meta.env.BASE_URL}
      class="header__logo"
      aria-label="Ir al inicio"
    >
      <img
        src={`${import.meta.env.BASE_URL}images/logo-huella.svg`}
        alt="Huella"
        class="header__logo-img"
      />
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__menu">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={site.social.whatsapp}
      class="btn btn-secondary header__cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      Pedir cita
    </a>

    <button
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
      type="button"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div id="mobile-menu" class="header__mobile" aria-hidden="true">
    <ul class="header__mobile-list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="header__mobile-link">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.social.whatsapp}
          class="btn btn-primary header__mobile-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Pedir cita
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  (function () {
    const toggle = document.querySelector(".header__toggle");
    const mobile = document.querySelector(".header__mobile");
    if (!toggle || !mobile) return;

    toggle.addEventListener("click", () => {
      const isOpen = mobile.classList.toggle("is-open");
      toggle.classList.toggle("is-active", isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
      mobile.setAttribute("aria-hidden", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    mobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobile.classList.remove("is-open");
        toggle.classList.remove("is-active");
        toggle.setAttribute("aria-expanded", "false");
        mobile.setAttribute("aria-hidden", "true");
        toggle.setAttribute("aria-label", "Abrir menú");
      });
    });
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 8000;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: clamp(4rem, 10vw, 5rem);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    position: static;
    transform: translateX(-15%);
  }

  .header__logo-img {
    display: block;
    width: 160px;
    height: auto;
  }

  .header__nav {
    display: none;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .header__link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    padding-block: 0.25rem;
    transition: color var(--transition-fast);
  }

  .header__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background-color: var(--text);
    transition: width var(--transition-base);
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--text);
  }

  .header__link:hover::after,
  .header__link:focus-visible::after {
    width: 100%;
  }

  .header__cta {
    display: none;
    padding: 0.75rem 1.25rem;
  }

  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.4rem;
  }

  .header__toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text);
    transition:
      transform var(--transition-base),
      opacity var(--transition-fast);
  }

  .header__toggle.is-active span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle.is-active span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle.is-active span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: var(--space-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base),
      transform var(--transition-base);
  }

  .header__mobile.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__mobile-link {
    display: block;
    padding-block: 0.5rem;
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--text);
  }

  .header__mobile-cta {
    margin-top: var(--space-sm);
    width: 100%;
  }

  @media (min-width: 768px) {
    .header__toggle,
    .header__mobile {
      display: none;
    }

    .header__nav,
    .header__cta {
      display: flex;
    }
  }
</style>
